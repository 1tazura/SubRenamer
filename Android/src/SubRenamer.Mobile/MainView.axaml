<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="SubRenamer.Mobile.MainView">
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="16">
    <Grid ColumnDefinitions="*,Auto,Auto">
      <StackPanel>
        <TextBlock Text="SubRenamer Android" FontSize="22" FontWeight="SemiBold"/>
        <TextBlock x:Name="RootText" Text="尚未授权 Download" Opacity="0.7" TextWrapping="Wrap"/>
      </StackPanel>
      <Button Grid.Column="1" Margin="8,0,0,0" Content="扫描" Click="Scan_Click"/>
      <Button Grid.Column="2" Margin="8,0,0,0" Content="更换目录" Click="ChangeRoot_Click"/>
    </Grid>

    <TextBlock Grid.Row="1" x:Name="StatusText" Margin="0,10,0,8" Text="等待初始化…" TextWrapping="Wrap"/>

    <Grid Grid.Row="2" RowDefinitions="2*,Auto,Auto,3*">
      <ListBox x:Name="SourceList" SelectionChanged="SourceList_SelectionChanged">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Border Padding="10" Margin="0,0,0,6" BorderThickness="1" CornerRadius="8">
              <TextBlock Text="{Binding Summary}" TextWrapping="Wrap"/>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <ComboBox Grid.Row="1" Margin="0,8,0,0"
                x:Name="CandidateCombo"
                SelectionChanged="CandidateCombo_SelectionChanged">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Display}" TextWrapping="Wrap"/>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>

      <StackPanel Grid.Row="2" Margin="0,8,0,0" Orientation="Horizontal" Spacing="8">
        <Button x:Name="PreviewButton" Content="重新生成预览" Click="Preview_Click"/>
        <Button x:Name="ApplyButton" Content="应用" Click="Apply_Click" IsEnabled="False"/>
      </StackPanel>

      <ScrollViewer Grid.Row="3" Margin="0,8,0,0">
        <TextBlock x:Name="PreviewText"
                   FontFamily="monospace"
                   TextWrapping="Wrap"
                   Text="选择一个字幕来源查看预览。"/>
      </ScrollViewer>
    </Grid>

    <TextBlock Grid.Row="3"
               Margin="0,8,0,0"
               Opacity="0.65"
               TextWrapping="Wrap"
               Text="视频文件永不移动/改名；字幕只写入现有视频目录；源字幕保留；已存在目标不覆盖。"/>
  </Grid>
</UserControl>
