<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <ApplicationId>io.github.subrenamer.mobile</ApplicationId>
    <ApplicationVersion>27</ApplicationVersion>
    <ApplicationDisplayVersion>0.1.26</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <AndroidUseLatestPlatformSdk>true</AndroidUseLatestPlatformSdk>
    <RunAOTCompilation>false</RunAOTCompilation>

    <!--
      Keep the project RID-neutral. CI publishes a physical-device package with
      `dotnet publish -r android-arm64`; this is the supported single-RID path and
      avoids embedding a second x86_64 copy of the .NET/Avalonia runtime.
    -->
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Xamarin.AndroidX.Core.SplashScreen" Version="1.2.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SubRenamer.Mobile\SubRenamer.Mobile.csproj" />
  </ItemGroup>

  <PropertyGroup Condition="'$(ApplicationId)' == 'io.github.subrenamer.mobile.networktest'">
    <DefineConstants>$(DefineConstants);NETWORK_TEST</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <AndroidNativeLibrary Include="../../native/.build/android/*.so" Abi="arm64-v8a" />
    <AndroidAsset Include="../../native/THIRD_PARTY_NOTICES.txt" />
    <AndroidAsset Include="../../native/LICENCE-LGPL-2.1.txt" />
  </ItemGroup>
  <Target Name="RequireSmbNativeLibraries" BeforeTargets="Build">
    <Error Condition="!Exists('../../native/.build/android/libsubrenamersmb.so')" Text="Build Android/native/build.sh for android before publishing." />
  </Target>

  <!--
    .NET 10 Android currently has an incremental BuildArchive bug which can make
    consecutive Avalonia publishes lose Java/JAR resources. Rebuilding the
    intermediate APK from scratch is the upstream-verified workaround and has no
    effect on application behavior or persistent user data.
  -->
  <Target Name="_SubRenamerCleanIntermediateApk" BeforeTargets="_BuildApkEmbed">
    <Delete Files="$(ApkFileIntermediate)" Condition="Exists('$(ApkFileIntermediate)')" />
  </Target>
</Project>
