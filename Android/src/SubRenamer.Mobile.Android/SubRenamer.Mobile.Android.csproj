<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <ApplicationId>io.github.subrenamer.mobile</ApplicationId>
    <ApplicationVersion>25</ApplicationVersion>
    <ApplicationDisplayVersion>0.1.24</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <AndroidUseLatestPlatformSdk>true</AndroidUseLatestPlatformSdk>
    <RuntimeIdentifier>android-arm64</RuntimeIdentifier>
    <RunAOTCompilation>false</RunAOTCompilation>

    <!--
      The sideload target for this port is modern ARM64 Android hardware. A
      single RuntimeIdentifier keeps restore/build/package on the same ABI and
      avoids carrying a second x86_64 copy of the .NET/Avalonia runtime.
      AOT stays disabled so the compact build preserves the current JIT runtime
      behavior and remains cross-buildable on the x64 GitHub Actions runner.
    -->
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Xamarin.AndroidX.Core.SplashScreen" Version="1.2.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SubRenamer.Mobile\SubRenamer.Mobile.csproj" />
  </ItemGroup>
</Project>
